Package: fastpotify
Architecture: amd64 arm64
Depends: ${misc:Depends}, libc6 (>= 2.39), libgcc-s1, libasound2t64 | libasound2,
 libpulse0, libgl1, libegl1, libx11-6, libx11-xcb1, libxcursor1, libxi6,
 libxrender1, libxkbcommon0, libxkbcommon-x11-0, libwayland-client0,
