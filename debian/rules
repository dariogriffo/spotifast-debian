#!/usr/bin/make -f
DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
PKG_VERSION := $(shell dpkg-parsechangelog -S Version | sed 's/[-~].*//')
UPSTREAM := https://github.com/crmne/spotifast/releases/download/v$(PKG_VERSION)

%:
	dh $@

override_dh_auto_configure:

# Upstream publishes Linux binaries for x86_64 and aarch64 only. Both are
# glibc linked and built on Ubuntu 24.04, so they need GLIBC_2.39. The
# archive holds the binary plus the desktop entry and icon under packaging/.
override_dh_auto_build:
	@case "$(DEB_HOST_ARCH)" in \
		amd64) TRIPLE="x86_64-unknown-linux-gnu" ;; \
		arm64) TRIPLE="aarch64-unknown-linux-gnu" ;; \
		*) echo "Unsupported architecture: $(DEB_HOST_ARCH)"; exit 1 ;; \
	esac; \
	ASSET="spotifast-v$(PKG_VERSION)-$$TRIPLE"; \
	echo "Downloading $$ASSET for $(PKG_VERSION)..."; \
	wget -q "$(UPSTREAM)/$$ASSET.tar.gz" -O spotifast.tar.gz; \
	mkdir -p dist; \
	tar -xf spotifast.tar.gz -C dist --strip-components=1; \
	rm -f spotifast.tar.gz

override_dh_auto_install:
	install -D -m 755 dist/spotifast debian/spotifast/usr/bin/spotifast
	install -D -m 644 dist/packaging/applications/spotifast.desktop debian/spotifast/usr/share/applications/spotifast.desktop
	install -D -m 644 dist/packaging/icons/spotifast.svg debian/spotifast/usr/share/icons/hicolor/scalable/apps/spotifast.svg

override_dh_auto_test:

override_dh_auto_clean:
	rm -rf dist spotifast.tar.gz || true

# The binary is a prebuilt upstream release: leave it exactly as published and
# do not try to derive library dependencies from it (they are declared by hand
# in debian/control).
override_dh_strip:

override_dh_shlibdeps:
